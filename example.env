# Settings for running the demo or the memory server on your own machine. Copy to `.env` and fill in the blanks
# (`.env` is never committed; this template holds no secrets). Each setting can also be an environment variable.
# README.md, "Configuration", says what each one does.

# Where the data and the memory live: sqlite (local files) or databricks (a SQL warehouse).
BACKEND=sqlite
# SQLITE_DATA=data/bgl.db
# SQLITE_MEMORY=data/memory.db

# With BACKEND=databricks. Sign-in comes from the Databricks SDK: `databricks auth login --profile <name>` once,
# then name the profile here.
# DATABRICKS_CONFIG_PROFILE=
# DATABRICKS_WAREHOUSE_ID=
# DEMO_CATALOG=
# DEMO_SCHEMA=shs_memory_demo
# MEMORY_CATALOG=
# MEMORY_SCHEMA=
# MEMORY_DB_CONNECTIONS=4

# The model: azure (Azure OpenAI, fill in the four values below) or databricks (a serving endpoint; no keys,
# sign-in as above).
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# the API version your deployment supports
OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
# Embeddings, for finding terms by meaning (Mem0, on by default). 1536 for text-embedding-3-small.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# EMBEDDING_DIMS=1536

# LLM_PROVIDER=databricks
# DATABRICKS_LLM_ENDPOINT=databricks-claude-sonnet-5-5
# DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en
# EMBEDDING_DIMS=1024

# none for GPT-5-family deployments (with tools they accept only none); unset for Claude.
# LLM_REASONING_EFFORT=none
# LLM_TEMPERATURE=
# LLM_TIMEOUT=90

# The demo.
# DEMO_TODAY=2005-12-01
# ORG_SEED=1
# ORG_CSV=seed/org.csv
# ORG_REFRESH_S=300
# PERSONAL_MEMORY=store
# JOKE_FILTER=1

# The memory MCP server run locally: no Databricks sign-in, so `user_email` is taken as given. Never on a shared host.
# MEMORY_ALLOW_ANONYMOUS=1
