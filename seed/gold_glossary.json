[
  {"term": "incidents", "aliases": ["incident"], "author": "jana.kral@shs-demo.example",
   "meaning": "events tagged as real alerts by the administrators",
   "sql_hint": "alert_label IS NOT NULL"},
  {"term": "fatal events", "aliases": ["fatals"], "author": "jana.kral@shs-demo.example",
   "meaning": "events with severity FATAL or FAILURE",
   "sql_hint": "level IN ('FATAL', 'FAILURE')"},
  {"term": "lustre problems", "aliases": ["lustre issues", "mount failures"], "author": "jana.kral@shs-demo.example",
   "meaning": "failed Lustre / filesystem mounts on compute nodes",
   "sql_hint": "alert_label IN ('KERNMNTF', 'KERNMNT')"},
  {"term": "TLB errors", "aliases": ["tlb error"], "author": "jana.kral@shs-demo.example",
   "meaning": "data TLB error interrupts",
   "sql_hint": "alert_label = 'KERNDTLB'"},
  {"term": "rts crashes", "aliases": ["kernel crashes"], "author": "jana.kral@shs-demo.example",
   "meaning": "compute-node kernel panics and terminations",
   "sql_hint": "alert_label IN ('KERNRTSP', 'KERNTERM')"},
  {"term": "core dumps", "aliases": [], "author": "jana.kral@shs-demo.example",
   "meaning": "core files written by crashing programs",
   "sql_hint": "event_template LIKE 'generating core%'"},
  {"term": "io nodes", "aliases": ["i/o nodes"], "author": "jana.kral@shs-demo.example",
   "meaning": "events reported by I/O cards",
   "sql_hint": "card_type = 'IO'"}
]
